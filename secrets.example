# ~/.secrets — API keys and tokens, sourced by ~/.zshrc (§3.7).
# install.sh copies this template to ~/.secrets (chmod 600) if it does not exist.
# NEVER commit the filled-in file.

# zsh-ai plugin (ZSH_AI_PROVIDER=gemini)
export GEMINI_API_KEY=""

# AWS SSO for ~/.scripts/aws-sso-login.sh (alias `creds [-e dev|prod]`)
export AWS_SSO_START_URL=""        # https://<directory-id>.awsapps.com/start
export AWS_SSO_DEV_ACCOUNT_ID=""
export AWS_SSO_DEV_ROLE=""
export AWS_SSO_PROD_ACCOUNT_ID=""
export AWS_SSO_PROD_ROLE=""

# Any other tokens (GitHub, GitLab, APIs…) go here as export NAME="value"
