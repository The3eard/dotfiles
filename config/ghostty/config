# =============================================================================
# Ghostty Configuration
# =============================================================================

# -- Theme --------------------------------------------------------------------
# Every terminal tool here references ANSI palette slots rather than hex, so this
# one line drives the colors of starship, the Claude Code status line, fzf, Helix,
# bat, git, eza and mvn. Changing it re-themes all of them.

theme = dark:GitHub Dark, light:GitHub Light Default

# -- Font ---------------------------------------------------------------------
# 0xProto Mono incluye Regular / Bold / Italic en la misma familia.
# Ghostty descubre las variantes solo; el bold-italic lo sintetiza.
font-family = 0xProto Nerd Font Mono

font-feature = calt
font-feature = liga

font-size = 12
font-thicken = true
adjust-cell-height = 25%

# -- Window -------------------------------------------------------------------
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-decoration = auto
window-theme = ghostty
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-window-shadow = true
macos-non-native-fullscreen = padded-notch

# -- Cursor -------------------------------------------------------------------
cursor-style = block
cursor-style-blink = true
shell-integration-features = cursor,sudo,title

# -- Mouse --------------------------------------------------------------------
mouse-hide-while-typing = true
copy-on-select = clipboard
link-url = true
mouse-scroll-multiplier = 2

# -- Clipboard ----------------------------------------------------------------
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true

# -- Scrollback ---------------------------------------------------------------
scrollback-limit = 10000

# -- macOS Icon ---------------------------------------------------------------
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = D3D3D3
macos-icon-screen-color = 000000

# -- macOS specific -----------------------------------------------------------
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = false
auto-update = check

# -- Splits -------------------------------------------------------------------
unfocused-split-opacity = 0.7
split-divider-color = 3d3d3d

# -- Quick Terminal -----------------------------------------------------------
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-screen = mouse

# -- Aesthetic (uncomment to enable translucency) -----------------------------
# background-opacity = 0.95
# background-blur = 20

# -- Keybindings --------------------------------------------------------------
# Split management
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom
keybind = super+alt+up=resize_split:up,10
keybind = super+alt+down=resize_split:down,10
keybind = super+alt+left=resize_split:left,10
keybind = super+alt+right=resize_split:right,10

# Tab management
keybind = super+t=new_tab
keybind = super+w=close_surface

# Font size
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Quick terminal toggle
keybind = global:super+grave_accent=toggle_quick_terminal
