# ══════════════════════════════════════════════════════════════════════════════
# 1. DEPENDENCIES
# ══════════════════════════════════════════════════════════════════════════════
# install.sh in the dotfiles repo runs all of this on macOS and Linux (Linux
# gets the same CLI tools through Homebrew on Linux). The manual equivalents
# below document what it does. Without them, aliases and plugins will break.
#
# ── 1.0 Prerequisites ────────────────────────────────────────────────────────
# Required before anything else in this section will work.
#   xcode-select --install                         # Xcode CLT — provides git, compilers
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"  # Homebrew
#
# ── 1.1 Core CLI tools ───────────────────────────────────────────────────────
#   brew install eza fd ripgrep bat fzf zoxide tldr difftastic starship
#   brew install sevenzip                          # provides 7zz (used by '7z' alias)
#   brew install mysql-client                      # mysql CLI (added to PATH)
#   brew install fnm                               # Node version manager (section 8)
#   fnm install 20.19.5 && fnm default 20.19.5     # Node used outside projects
#
# ── 1.2 ZSH plugins (Homebrew) ───────────────────────────────────────────────
#   brew install zsh-fast-syntax-highlighting zsh-autosuggestions zsh-ai
#
# ── 1.3 Vendored plugins ─────────────────────────────────────────────────────
# Single files copied from Oh My Zsh (no framework). Re-run to update.
#   mkdir -p ~/.config/zsh/plugins
#   curl -fsSLo ~/.config/zsh/plugins/sudo.plugin.zsh \
#     https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/plugins/sudo/sudo.plugin.zsh
#
# ── 1.4 Fonts & themes ───────────────────────────────────────────────────────
# A Nerd Font is REQUIRED for icons in eza, starship, fzf, and the version
# auto-switch hook (section 8). Install one and set it in your terminal:
#   brew install --cask font-jetbrains-mono-nerd-font
#
# bat needs no theme install: ~/.config/bat/config selects OneHalfLight /
# OneHalfDark from macOS appearance via --theme=auto:system, and both ship
# with bat. Do NOT set BAT_THEME — the env var overrides that config file.
#
# ── 1.5 Optional / project-specific ──────────────────────────────────────────
#   curl -s "https://get.sdkman.io" | bash         # Java/Tomcat version manager
#   brew install awscli                            # AWS CLI (completion in 2.3 + 'creds' alias)
#   brew install --cask docker                     # Docker Desktop
#   brew install --cask ghostty                    # terminal (CSI u keybinds in 5.4.1)
#   brew install --cask zed                         # GUI editor ($VISUAL)
#     then symlink its CLI onto PATH so `zed`/`zed --wait` work:
#       ln -sf "/Applications/Zed.app/Contents/MacOS/cli" ~/.local/bin/zed
#   npm install -g @anthropic-ai/claude-code       # Claude Code CLI (cc / ccy aliases)
#
# ── 1.6 Required files ───────────────────────────────────────────────────────
#   ~/.secrets             — API keys and tokens (not version-controlled). Vars:
#                              export GEMINI_API_KEY="..."    # zsh-ai (sec. 3.6)
#                              export ANTHROPIC_API_KEY="..." # optional, Claude
#                              (plus any project-specific tokens)
#   ~/.gitconfig           — configures difftastic as the diff tool
#                            (e.g. `git dft` → structural syntax diff)
#   ~/.config/starship.toml — starship prompt config (referenced in section 7.3)


# ══════════════════════════════════════════════════════════════════════════════
# 2. SHELL CORE
# ══════════════════════════════════════════════════════════════════════════════
# Plain zsh, no framework: only the defaults this setup relies on. Startup
# cost matters here — every line runs on each new tab.

# ── 2.1 Options ──────────────────────────────────────────────────────────────
setopt auto_cd                # type a directory name alone to cd into it
setopt auto_pushd             # cd pushes the old dir on the stack (cd -<Tab> lists it)
setopt pushd_ignore_dups      # no duplicate entries in that stack
setopt pushd_minus            # cd -1 is the most recent dir, not the oldest
setopt interactive_comments   # allow # comments on the command line
setopt long_list_jobs         # job notifications include the PID
unsetopt flow_control         # frees Ctrl+S / Ctrl+Q from pausing output
WORDCHARS=''                  # word motions (Ctrl+W, Ctrl+←/→) stop at / . - _ inside paths

# ── 2.2 History ──────────────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000                # entries kept in memory
SAVEHIST=10000                # entries kept in HISTFILE
setopt extended_history       # store a timestamp with each entry
setopt hist_expire_dups_first # when trimming, drop duplicates first
setopt hist_ignore_dups       # don't store a command identical to the previous one
setopt hist_ignore_space      # a leading space keeps a command out of history
setopt hist_verify            # !! and friends expand into the line instead of running
setopt share_history          # every open shell reads and appends the same history

# ── 2.3 Completion ───────────────────────────────────────────────────────────
# Homebrew lives in /opt/homebrew on macOS and /home/linuxbrew/.linuxbrew on
# Linux. Detected with a directory test instead of `brew shellenv`, which forks.
if [[ -d /opt/homebrew ]]; then
  export HOMEBREW_PREFIX=/opt/homebrew
elif [[ -d /home/linuxbrew/.linuxbrew ]]; then
  export HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
fi

# Homebrew formulae (fnm, gh, …) install completions into site-functions;
# the system zsh does not search it by default.
fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $HOME/.docker/completions $fpath)

zmodload zsh/complist         # menu-select widget used below
autoload -Uz compinit bashcompinit
compinit
bashcompinit                  # accepts bash `complete` specs (aws below, SDKMAN in 7.1)
complete -C aws_completer aws

setopt complete_in_word       # complete from the cursor, not only at the end of the word
setopt always_to_end          # move the cursor after the completed word
zstyle ':completion:*' menu select                   # arrow-key navigable menu
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'  # case-insensitive, then substring
zstyle ':completion:*' special-dirs true             # complete . and ..
zstyle ':completion:*' list-colors ''                # default colours in the menu
zstyle ':completion:*' use-cache yes                 # cache slow completers (brew, docker)
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/zcompcache"
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories

# ── 2.4 Key bindings ─────────────────────────────────────────────────────────
# Emacs keymap explicitly: zsh picks vi mode when $EDITOR or $VISUAL contains "vi".
# Each cursor key is bound in both forms a terminal can send (CSI `^[[` and SS3 `^[O`).
bindkey -e

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search    # ↑ — previous command starting with what is typed
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search  # ↓ — next one
bindkey '^[OB' down-line-or-beginning-search

bindkey '^[[H' beginning-of-line              # Home
bindkey '^[OH' beginning-of-line
bindkey '^[[F' end-of-line                    # End
bindkey '^[OF' end-of-line
bindkey '^[[3~' delete-char                   # Delete (forward)
bindkey '^[[1;5C' forward-word                # Ctrl+→
bindkey '^[[1;5D' backward-word               # Ctrl+←
bindkey '^[[Z' reverse-menu-complete          # Shift+Tab — previous completion entry
bindkey ' ' magic-space                       # expand !! / !$ when Space is typed

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line              # Ctrl+X Ctrl+E — edit the line in $VISUAL

# Pasted URLs get their ? & * quoted automatically.
autoload -Uz bracketed-paste-magic url-quote-magic
zle -N bracketed-paste bracketed-paste-magic
zle -N self-insert url-quote-magic

# ── 2.5 Vendored plugins ─────────────────────────────────────────────────────
# Esc Esc prepends sudo to the current line (or to the previous command if the
# line is empty); on an $EDITOR command it switches to `sudo -e`. Source: 1.3.
source "$HOME/.config/zsh/plugins/sudo.plugin.zsh"


# ══════════════════════════════════════════════════════════════════════════════
# 3. ENVIRONMENT
# ══════════════════════════════════════════════════════════════════════════════

# ── 3.1 Editors ───────────────────────────────────────────────────────────────
export EDITOR="hx"                        # terminal editor (git commit, crontab, etc.)
export VISUAL="zed --wait"                # GUI editor (Zed); --wait blocks until the file is closed

# ── 3.2 PATH ─────────────────────────────────────────────────────────────────
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"  # brew before /usr/bin
export PATH="$HOME/.local/bin:$PATH"            # user scripts and tools
export PATH="$HOMEBREW_PREFIX/opt/mysql-client/bin:$PATH"  # mysql-client CLI

# ── 3.3 Theming ──────────────────────────────────────────────────────────────
# No BAT_THEME here on purpose: it would override ~/.config/bat/config, which
# already picks OneHalfLight/OneHalfDark from macOS appearance (--theme=auto:system).
export MANPAGER="sh -c 'col -bx | bat -l man -p'"  # bat as man page viewer
export LESS='-R'                          # less shows ANSI colours instead of raw escape codes

# ── 3.4 SDKMAN (Java toolchain) ──────────────────────────────────────────────
export SDKMAN_DIR="$HOME/.sdkman"
export JAVA_HOME="$HOME/.sdkman/candidates/java/current"
export CATALINA_HOME="$HOME/.sdkman/candidates/tomcat/current"

# ── 3.5 Claude Code ──────────────────────────────────────────────────────────
export ENABLE_LSP_TOOL=1

# ── 3.6 ZSH-AI plugin ────────────────────────────────────────────────────────
export ZSH_AI_PROVIDER="gemini"

# ── 3.6b Shell behavior ──────────────────────────────────────────────────────
PROMPT_EOL_MARK=''                        # hide the % marker on output with no trailing newline
# Sube el nivel de log de starship a ERROR para silenciar sus WARN. El que salía
# era "Executing command … timed out" del módulo nodejs: tras un cambio de versión
# el binario de node (~132 MB) puede tardar >1s en su primer exec en frío y se pasa
# del command_timeout de starship.toml (§ver starship.toml:9). Es cosmético — solo
# se pierde la versión de node en ese prompt y el siguiente ya sale bien.
# Contrapartida: los errores de config inválida en ~/.config/starship.toml también
# se emiten como WARN (comprobado: "Unknown key"), así que quedan ocultos.
export STARSHIP_LOG=error

# ── 3.7 Secrets (API keys, tokens) ───────────────────────────────────────────
# Loaded from a separate file that is NOT version-controlled.
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"


