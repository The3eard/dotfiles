# 4. ALIASES
# ══════════════════════════════════════════════════════════════════════════════

# ── 4.1 File listing (eza replaces ls) ────────────────────────────────────────
alias l='eza --icons'                     # compact listing with icons
alias ls='eza --icons'                    # default ls replacement
alias ll='eza -la --icons --git'          # detailed listing with git status
alias lt='eza --tree --icons --level=2'   # tree view (2 levels deep)
alias lta='eza --tree --icons -a --level=2'  # tree view including hidden files

# ── 4.2 File viewing & editing (bat + helix) ─────────────────────────────────
alias cat='bat'                           # syntax-highlighted cat with line numbers
alias vi='hx'                             # always use helix
alias vim='hx'                            # always use helix
alias editor='hx'                         # quick access to helix

# ── 4.3 Navigation ───────────────────────────────────────────────────────────
alias ..='cd ..'                          # go up one level
alias ...='cd ../..'                      # go up two levels
alias ....='cd ../../..'                  # go up three levels
alias -- -='cd -'                         # back to the previous directory

# ── 4.4 Shell utilities ──────────────────────────────────────────────────────
alias cl='clear'                          # clear terminal
alias q='exit'                            # quick exit
alias reload='source ~/.zshrc'            # reload this config without restarting
alias help='tldr'                         # quick cheatsheets (usage: help tar)
alias grep='grep --color=auto --exclude-dir={.git,.idea}'  # coloured matches, skip VCS/IDE dirs
alias update='brew update && brew upgrade --greedy && brew autoremove'  # update all Homebrew packages

# ── 4.5 Network & system info ────────────────────────────────────────────────
alias ports='lsof -iTCP -sTCP:LISTEN -nP' # list all listening TCP ports
alias ip='curl -s ifconfig.me'            # public IP address
alias weather='curl -s wttr.in/?format=3' # quick weather for current location
alias path='echo $PATH | tr ":" "\n"'     # print PATH entries one per line
alias sizeof='du -sh'                     # show size of file/dir (usage: sizeof ./folder)

# ── 4.6 AWS ──────────────────────────────────────────────────────────────────
# ~/.scripts/aws-sso-login.sh comes from the dotfiles repo; its account IDs and
# SSO URL are read from ~/.secrets (AWS_SSO_* vars).
# Usage: creds [-e dev|prod]   (default: dev)
alias creds='~/.scripts/aws-sso-login.sh' # refresh AWS SSO credentials

# ── 4.7 Claude ───────────────────────────────────────────────────────────
alias ck='claude --agent kojima'          # launch Claude Code with the kojima orchestrator (~/.claude/agents)
alias cky='claude --agent kojima --dangerously-skip-permissions' # kojima orchestrator with all permissions
alias cc='claude'
alias ccy='claude --dangerously-skip-permissions'  # plain Claude Code with all permissions

# ── 4.8 7zip ────────────────────────────────────────────────────────────────
alias 7z='7zz'  # use 7zz (the newer, faster version of 7z) for all archive operations

# -- 4.9 Python -------------------------------------------------------------
alias py='python3'

# ══════════════════════════════════════════════════════════════════════════════
# 5. FZF (Fuzzy Finder)
# ══════════════════════════════════════════════════════════════════════════════

# ── 5.1 Default behavior ─────────────────────────────────────────────────────
# Uses fd instead of find for speed. Respects .gitignore, includes hidden files.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'

# ── 5.2 Appearance (follows the terminal theme) ───────────────────────────────
# ANSI slot numbers and -1, not hex: -1 means "terminal default", so the picker
# inherits the terminal background instead of painting its own, and follows the
# Ghostty theme in both modes. Previously this hardcoded Catppuccin Mocha hex
# including bg:#101010, which stayed a dark box inside a light terminal.
#   bg+ keeps a real slot (8) — as a background band a low ratio is what you want,
#   and -1 there would leave the selected row with no highlight at all.
#   border uses -1 rather than a slot: no slot is mid-tone in both modes (slot 8
#   is 1.77:1 on Apple System Colors dark, slot 7 is 2.87:1 on its Light variant).
export FZF_DEFAULT_OPTS='
  --height=60%
  --layout=reverse
  --border
  --info=inline
  --preview-window=right:50%:wrap
  --color=fg:-1,bg:-1,hl:4
  --color=fg+:-1,bg+:8,hl+:4
  --color=info:2,prompt:4,pointer:5
  --color=marker:1,spinner:5,header:6
  --color=border:-1
'

# ── 5.3 Key binding overrides ────────────────────────────────────────────────
# Ctrl+T — insert file path (with bat preview)
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:300 {}'"

# Alt+C — cd into directory (with eza tree preview)
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --icons --level=2 --color=always {}'"

# ── 5.4 Load fzf key bindings and completions ────────────────────────────────
source <(fzf --zsh)

# ── 5.4.1 CSI u (kitty protocol) keybindings for Ghostty ────────────────────
# Ghostty sends CSI u sequences (e.g. \e[114;5u for Ctrl+R) instead of classic
# control codes. Bind these so fzf and other widgets work correctly.
bindkey '\e[114;5u' fzf-history-widget    # Ctrl+R → fzf history
bindkey '\e[116;5u' fzf-file-widget       # Ctrl+T → fzf file finder

# ── 5.5 Interactive finder functions ──────────────────────────────────────────

# ff — fuzzy find a file and open it in $EDITOR
ff() {
  local file
  file=$(fd --type f --hidden --follow --exclude .git | fzf --preview 'bat --color=always --style=numbers --line-range=:300 {}')
  [ -n "$file" ] && ${EDITOR:-hx} "$file"
}

# fdd — fuzzy find a directory and cd into it
fdd() {
  local dir
  dir=$(fd --type d --hidden --follow --exclude .git | fzf --preview 'eza --tree --icons --level=2 --color=always {}')
  [ -n "$dir" ] && cd "$dir"
}

# rgi — interactive ripgrep: search content → preview with bat → open in $EDITOR
rgi() {
  local selection
  selection=$(rg --color=always --line-number --no-heading "${1:-.}" |
    fzf --ansi --delimiter=: \
        --preview 'bat --color=always --highlight-line {2} --line-range=$(( {2} > 10 ? {2} - 10 : 1 )):$(( {2} + 10 )) {1}' \
        --preview-window='right:50%:wrap')
  [ -n "$selection" ] && ${EDITOR:-hx} "$(echo "$selection" | cut -d: -f1)" "+$(echo "$selection" | cut -d: -f2)"
}

# fkill — fuzzy find a process and kill it (default signal: SIGKILL)
fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf --header='Select process to kill' | awk '{print $2}')
  [ -n "$pid" ] && kill -${1:-9} "$pid"
}


# ══════════════════════════════════════════════════════════════════════════════
# 6. EXTERNAL PLUGINS
# ══════════════════════════════════════════════════════════════════════════════
