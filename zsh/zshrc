# ── 6.1 Syntax highlighting ──────────────────────────────────────────────────
# Colors valid/invalid commands as you type (green = valid, red = not found).
# fast-syntax-highlighting rather than zsh-syntax-highlighting: it stays
# responsive on long lines and big pastes.
source $HOMEBREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# ── 6.2 Autosuggestions ──────────────────────────────────────────────────────
# Suggests commands from history in gray text. Accept with → (right arrow).
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ── 6.3 ZSH-AI ───────────────────────────────────────────────────────────────
# AI-powered command suggestions. Provider configured in section 3.6.
source $HOMEBREW_PREFIX/share/zsh-ai/zsh-ai.plugin.zsh


# ══════════════════════════════════════════════════════════════════════════════
# 7. INITIALIZATIONS (must be last)
# ══════════════════════════════════════════════════════════════════════════════
# These tools modify the prompt or hook into cd — they must load after
# everything else to work correctly.

# ── 7.1 SDKMAN ───────────────────────────────────────────────────────────────
# Manages Java, Maven, Tomcat versions. Must be near the end per SDKMAN docs.
[ -f "$SDKMAN_DIR/bin/sdkman-init.sh" ] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# ── 7.2 Zoxide (smarter cd) ──────────────────────────────────────────────────
# Replaces the z plugin. Learns directories you visit.
# Usage: z <partial-dir-name>, zi (interactive with fzf)
eval "$(zoxide init zsh)"

# ── 7.3 Starship prompt (MUST be last) ───────────────────────────────────────
# Cross-shell prompt with git info, language versions, etc.
# Config: ~/.config/starship.toml
eval "$(starship init zsh)"


# ══════════════════════════════════════════════════════════════════════════════
# 8. FNM + SDKMAN — QUIET AUTO-SWITCH
# ══════════════════════════════════════════════════════════════════════════════
# Node.js comes from fnm (driven by .nvmrc), Java/Maven/Tomcat from SDKMAN
# (driven by .sdkmanrc). Neither tool's own cd hook is on — no --use-on-cd
# below, and sdkman_auto_env=false in ~/.sdkman/etc/config — because the hook
# in 8.2 replaces both with one quiet summary line.

# ── 8.1 Load fnm ─────────────────────────────────────────────────────────────
# Puts a per-shell Node symlink on PATH, so `fnm use` switches only this shell.
# Versions live in ~/.local/share/fnm; `fnm default` is the one used outside
# projects. Global npm packages are per version, as with any Node manager.
eval "$(fnm env --shell zsh)"

# Prints the nearest .nvmrc from $1 (default $PWD) up to /; fails if none.
_find_nvmrc() {
  local dir="${1:-$PWD}"
  while true; do
    [[ -f "$dir/.nvmrc" ]] && { print -r -- "$dir/.nvmrc"; return 0; }
    [[ "$dir" == / ]] && return 1
    dir="${dir:h}"
  done
}

# ── 8.2 Quiet version switch on cd / git checkout (SDKMAN + fnm) ─────────────
# Instead of 5+ noisy lines, prints one styled line with Nerd Font icons
# and actual version numbers.
#
# Triggers:
#   1. chpwd  — when you cd into a project directory.
#   2. precmd — only after running a git command that may rewrite tracked
#               files (checkout, switch, pull, merge, rebase, reset, stash,
#               cherry-pick, restore, am, clone). A `preexec` hook sets a
#               flag for those; for everything else `precmd` is a no-op
#               (single integer test), so prompts stay fast.
autoload -U add-zsh-hook
zmodload -F zsh/stat b:zstat    # portable mtime: BSD and GNU `stat` take different flags
typeset -g _versions_recheck=0
typeset -gA _versions_seen      # PWD → "<sdkmanrc_mtime>|<nvmrc_mtime>|<active node>|<PATH>"

_auto_switch_versions() {
  # Only activate inside ~/Projects
  [[ "$PWD" != "$HOME/Projects"* ]] && return

  # Fast exit: if no .sdkmanrc here and no .nvmrc anywhere up the tree,
  # there is nothing to manage — bail before doing any other work.
  local has_sdkrc=0 nvmrc_path=""
  [[ -f .sdkmanrc ]] && has_sdkrc=1
  nvmrc_path="$(_find_nvmrc)"
  (( has_sdkrc )) || [[ -n "$nvmrc_path" ]] || return

  # Skip the rest when nothing changed since the last visit to this PWD:
  # same version-file mtimes AND the shell still on the versions that visit
  # left it on. Covers repeat cds and git operations that didn't touch the
  # version files. The active-version half is what makes returning from
  # another project switch back: the active Node is read from fnm's per-shell
  # symlink (no fork), and SDKMAN's choice lives in PATH, which `sdk env`
  # rewrites.
  local sdk_m="" nvm_m=""
  (( has_sdkrc ))         && sdk_m=$(zstat +mtime -- .sdkmanrc     2>/dev/null)
  [[ -n "$nvmrc_path" ]]  && nvm_m=$(zstat +mtime -- "$nvmrc_path" 2>/dev/null)
  [[ "${_versions_seen[$PWD]:-}" == "$sdk_m|$nvm_m|${FNM_MULTISHELL_PATH:A}|$PATH" ]] && return

  # Nerd Font icons — same codepoints as starship.toml where possible
  local nf_java=$'\ue256'       # nf-fae-java (same as starship [java])
  local nf_maven='mvn'          # plain text, no nerd font icon for maven
  local nf_tomcat='tomcat'      # plain text
  local nf_node=$'\ue718'       # nf-dev-nodejs_small (same as starship [nodejs])

  local parts=()

  # SDKMAN: parse .sdkmanrc once, then either switch silently (if every
  # requested candidate is already installed) or warn the user (don't
  # auto-install — `sdk env install` can take minutes downloading).
  local sdk_missing=()
  if (( has_sdkrc )); then
    local java_ver="" maven_ver="" tomcat_ver="" key value
    while IFS='=' read -r key value; do
      [[ -z "$key" || "$key" = \#* ]] && continue
      case "$key" in
        java)   java_ver="$value" ;;
        maven)  maven_ver="$value" ;;
        tomcat) tomcat_ver="$value" ;;
      esac
    done < .sdkmanrc

    # Check installed-ness via the candidate's install dir.
    [[ -n "$java_ver"   && ! -d "$SDKMAN_DIR/candidates/java/$java_ver"     ]] && sdk_missing+=("java $java_ver")
    [[ -n "$maven_ver"  && ! -d "$SDKMAN_DIR/candidates/maven/$maven_ver"   ]] && sdk_missing+=("maven $maven_ver")
    [[ -n "$tomcat_ver" && ! -d "$SDKMAN_DIR/candidates/tomcat/$tomcat_ver" ]] && sdk_missing+=("tomcat $tomcat_ver")

    if (( ${#sdk_missing[@]} == 0 )); then
      # Check if a switch is actually needed before invoking SDKMAN.
      # IMPORTANT: compare against the version active in THIS shell's PATH,
      # not the global `current` symlink. Another shell may have done
      # `sdk use <cand> <ver>` (which pins the absolute path in its own PATH
      # without moving the symlink), or this shell may have a pinned path
      # while the symlink was moved elsewhere — relying on the symlink would
      # falsely conclude "nothing to do" and leave this session on the wrong
      # version.
      _active_sdk_version() {
        # $1 = candidate name (java|maven|tomcat). Echoes the version
        # currently in effect for this shell, resolving `current` via readlink.
        local cand="$1" p ver
        for p in ${(s/:/)PATH}; do
          if [[ "$p" == "$SDKMAN_DIR/candidates/$cand/"*"/bin" ]]; then
            ver="${${p#$SDKMAN_DIR/candidates/$cand/}%/bin}"
            if [[ "$ver" == "current" ]]; then
              ver="${$(readlink "$SDKMAN_DIR/candidates/$cand/current" 2>/dev/null):t}"
            fi
            print -r -- "$ver"
            return
          fi
        done
      }
      local need_sdk=0 cur
      if [[ -n "$java_ver" ]]; then
        cur="$(_active_sdk_version java)"
        [[ "$cur" != "$java_ver" ]] && need_sdk=1
      fi
      if (( ! need_sdk )) && [[ -n "$maven_ver" ]]; then
        cur="$(_active_sdk_version maven)"
        [[ "$cur" != "$maven_ver" ]] && need_sdk=1
      fi
      if (( ! need_sdk )) && [[ -n "$tomcat_ver" ]]; then
        cur="$(_active_sdk_version tomcat)"
        [[ "$cur" != "$tomcat_ver" ]] && need_sdk=1
      fi
      unfunction _active_sdk_version
      if (( need_sdk )); then
        sdk env > /dev/null 2>&1   # switch only, no install — fast path
        [[ -n "$java_ver"   ]] && parts+=("%F{215}$nf_java %F{245}${java_ver%%-*}%f")
        [[ -n "$maven_ver"  ]] && parts+=("%F{141}$nf_maven %F{245}$maven_ver%f")
        [[ -n "$tomcat_ver" ]] && parts+=("%F{216}$nf_tomcat %F{245}$tomcat_ver%f")
      fi
    fi
  fi

  # fnm: switch only when the wanted version is installed; otherwise
  # warn the user (don't auto-install — `fnm install` downloads Node).
  # `fnm use` fails for a missing version; stdin from /dev/null stops it
  # from asking to install it instead when attached to a terminal.
  local node_missing=""
  if [[ -n "$nvmrc_path" ]]; then
    local wanted_raw="$(<"${nvmrc_path}")"
    local before_node="$(fnm current)"
    if fnm use "$wanted_raw" --silent-if-unchanged --log-level=quiet </dev/null 2>/dev/null; then
      local after_node="$(fnm current)"
      [[ "$after_node" != "$before_node" ]] && parts+=("%F{114}$nf_node %F{245}$after_node%f")
    else
      node_missing="$wanted_raw"
    fi
  elif [[ -n "$(_find_nvmrc "$OLDPWD")" ]]; then
    # Left a Node project for one that only has .sdkmanrc: back to the default.
    fnm use default --silent-if-unchanged --log-level=quiet </dev/null 2>/dev/null
  fi

  # Recorded after switching, so it describes the state this visit leaves.
  _versions_seen[$PWD]="$sdk_m|$nvm_m|${FNM_MULTISHELL_PATH:A}|$PATH"

  # Pretty one-liner with icons and versions (only for actual switches)
  if (( ${#parts[@]} > 0 )); then
    local line=""
    for part in "${parts[@]}"; do
      [[ -n "$line" ]] && line+="%F{240} · %f"
      line+="$part"
    done
    print -P "%F{242}╭ Versions switched%f"
    print -P "%F{242}╰%f $line"
  fi

  # Warn (don't auto-install) when a requested version is missing.
  if (( ${#sdk_missing[@]} > 0 )) || [[ -n "$node_missing" ]]; then
    print -P "%F{215}╭ Versions not installed%f"
    if (( ${#sdk_missing[@]} > 0 )); then
      local m miss=""
      for m in "${sdk_missing[@]}"; do
        [[ -n "$miss" ]] && miss+="%F{240}, %f"
        miss+="%F{245}$m%f"
      done
      print -P "%F{215}│%f $miss   %F{240}→%f %F{114}sdk env install%f"
    fi
    if [[ -n "$node_missing" ]]; then
      print -P "%F{215}│%f %F{245}node $node_missing%f   %F{240}→%f %F{114}fnm install%f"
    fi
    print -P "%F{215}╰%f"
  fi
}
add-zsh-hook chpwd _auto_switch_versions

# Mark a re-check pending when running git commands that can rewrite
# .sdkmanrc / .nvmrc (checkout, switch, pull, merge, rebase, reset,
# stash, cherry-pick, restore, am, clone). Matches plain `git …` and
# common wrappers like `sudo git …`.
_versions_before_cmd() {
  case "$1" in
    *"git checkout"*|*"git switch"*|*"git pull"*|*"git merge"*|*"git rebase"*|*"git reset"*|*"git stash"*|*"git cherry-pick"*|*"git restore"*|*"git am"*|*"git clone"*)
      _versions_recheck=1
      ;;
  esac
}
# Cheap fast path: bail immediately unless a git command flagged us.
_versions_before_prompt() {
  (( _versions_recheck )) || return
  _versions_recheck=0
  _auto_switch_versions
}
add-zsh-hook preexec _versions_before_cmd
add-zsh-hook precmd _versions_before_prompt

_auto_switch_versions

